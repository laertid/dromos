client
dev tun
proto tcp-client
remote {{ dromos_phebes_endpoint }} 443
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth   SHA256
verb 3

<ca>
{{ dromos_ovpn_ca_crt }}
</ca>
<cert>
{{ user.ovpn_cert }}
</cert>
<key>
{{ user.ovpn_key }}
</key>
<tls-crypt>
{{ dromos_ovpn_ta_key }}
</tls-crypt>
