#!/bin/bash
# dromos-init-inventory -- interactively build ansible/inventory/prod.ini.
#
# Prompts for the two node IPs and the Phebes public DNS endpoint, then writes
# a ready-to-use inventory.  Refuses to clobber an existing prod.ini unless
# --force is given (or you confirm at the prompt).
#
# Flags (also let you run it non-interactively, e.g. in tests/CI):
#   --phebes-ip IP        Phebes (RU node) public IP        [prompted]
#   --peleon-ip IP        Peleon (IT node) public IP        [prompted]
#   --phebes-endpoint H   Phebes public DNS name/hostname   [prompted]
#   --ssh-user USER       ansible_user for both nodes       [default: root]
#   --ssh-key PATH        ansible_ssh_private_key_file      [default: none]
#   --output PATH         where to write                    [ansible/inventory/prod.ini]
#   --force               overwrite an existing output file without asking
#   --non-interactive     never prompt; fail if a required value is missing
#   -h, --help            show this help
#
set -uo pipefail

# Resolve repo root from this script's location so it works from anywhere.
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

OUTPUT=${DROMOS_INVENTORY_OUT:-"$REPO_ROOT/ansible/inventory/prod.ini"}
SSH_USER_DEFAULT="root"

phebes_ip=""
peleon_ip=""
phebes_endpoint=""
ssh_user=""
ssh_key=""
force=0
interactive=1

die() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() { sed -n '2,18p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --phebes-ip)        phebes_ip=${2:-};       shift 2 ;;
        --peleon-ip)        peleon_ip=${2:-};       shift 2 ;;
        --phebes-endpoint)  phebes_endpoint=${2:-}; shift 2 ;;
        --ssh-user)         ssh_user=${2:-};        shift 2 ;;
        --ssh-key)          ssh_key=${2:-};         shift 2 ;;
        --output)           OUTPUT=${2:-};          shift 2 ;;
        --force)            force=1;                shift ;;
        --non-interactive)  interactive=0;          shift ;;
        -h|--help)          usage ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

# Prompt for a required value when interactive and still empty; in
# non-interactive mode a still-empty required value is a fatal error.
# $1=varname  $2=prompt text
ask_required() {
    local __var=$1 __prompt=$2 __reply
    [[ -n "${!__var}" ]] && return 0
    (( interactive )) || die "missing required value for $__var (non-interactive mode)"
    read -r -p "$__prompt: " __reply
    printf -v "$__var" '%s' "$__reply"
}

# Prompt for an optional value with a default; never fatal.
# $1=varname  $2=prompt text  $3=default
ask_optional() {
    local __var=$1 __prompt=$2 __default=$3 __reply
    [[ -n "${!__var}" ]] && return 0
    (( interactive )) || { printf -v "$__var" '%s' "$__default"; return 0; }
    read -r -p "$__prompt [${__default:-none}]: " __reply
    printf -v "$__var" '%s' "${__reply:-$__default}"
}

ask_required phebes_ip       "Phebes (RU node) public IP"
ask_required peleon_ip       "Peleon (IT node) public IP"
ask_required phebes_endpoint "Phebes public DNS name / endpoint hostname"
ask_optional ssh_user        "SSH user for both nodes" "$SSH_USER_DEFAULT"
ask_optional ssh_key         "SSH private key path (blank for agent/default)" ""

[[ -n "$phebes_ip" ]]       || die "Phebes IP is required"
[[ -n "$peleon_ip" ]]       || die "Peleon IP is required"
[[ -n "$phebes_endpoint" ]] || die "Phebes endpoint is required"
[[ -n "$ssh_user" ]]        || ssh_user=$SSH_USER_DEFAULT

# Don't clobber an existing inventory without consent.
if [[ -e "$OUTPUT" && $force -eq 0 ]]; then
    if (( interactive )); then
        read -r -p "$OUTPUT already exists. Overwrite? [y/N]: " reply
        [[ "$reply" =~ ^[Yy]$ ]] || die "aborted; existing file left untouched"
    else
        die "$OUTPUT exists; pass --force to overwrite"
    fi
fi

# Optional per-host key line, only when a key was supplied.
key_attr=""
[[ -n "$ssh_key" ]] && key_attr=" ansible_ssh_private_key_file=$ssh_key"

mkdir -p "$(dirname "$OUTPUT")"
cat > "$OUTPUT" <<EOF
; Generated by scripts/dromos-init-inventory.  prod.ini is gitignored.
; Host names differ from group names on purpose: Ansible warns when a host
; and a group share a name. Playbooks target the groups (hosts: phebes),
; which still resolve to these hosts via the group membership below.
[phebes]
phebes-1 ansible_host=$phebes_ip ansible_user=$ssh_user$key_attr

[peleon]
peleon-1 ansible_host=$peleon_ip ansible_user=$ssh_user$key_attr

[dromos:children]
phebes
peleon

[dromos:vars]
; -- network ----------------------------------------------------------------
dromos_client_subnet_v4 = 10.66.0.0/24
dromos_client_ifname    = dromos-client
dromos_backbone_ifname  = dromos-backbone
dromos_egress_ifname    = eth0
dromos_client_listen_port           = 51820
dromos_backbone_listen_port_phebes  = 51821
dromos_backbone_listen_port_peleon  = 51821
dromos_mark_ru      = 0x42
dromos_mark_foreign = 0x43
dromos_table_ru      = 100
dromos_table_foreign = 101

; -- public endpoints -------------------------------------------------------
dromos_phebes_endpoint = $phebes_endpoint
dromos_peleon_host     = $peleon_ip

; -- geo --------------------------------------------------------------------
dromos_geo_url = https://www.ipdeny.com/ipblocks/data/aggregated/ru-aggregated.zone
EOF

printf 'Wrote %s\n' "$OUTPUT"
